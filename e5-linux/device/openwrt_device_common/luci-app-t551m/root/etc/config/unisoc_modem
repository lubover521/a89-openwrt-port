config core 'main'
	option at_backend 'custom'
	option at_port '/dev/stty_nr2'
	option at_command '/usr/libexec/unisoc-modem/t551m-at'
	option data_interface 'wan'
	option data_interface_v6 'wan6'
	option data_device 'sipa_eth0'
	option lan_device 'br-lan'
	option wifi_device 'wlan0'
	option usb_device 'usb0'
	option replay_timeout '90'
	option home_refresh_interval '2'
	option state_dir '/etc/unisoc-modem/lock-state.d'

config device 'usb'
	option role_auto '0'
	option lan_auto '1'
	option net_mode 'ncm'
	option net_scope 'permanent'
	option net_auto '0'
	option role_command ''
