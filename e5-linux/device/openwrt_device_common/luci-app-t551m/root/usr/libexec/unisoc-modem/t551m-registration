#!/usr/bin/env python3
"""Cached ModemManager registration; unknown cell IDs remain null."""
import json
import os
import subprocess
from pathlib import Path

try:
    slot = os.environ.get('MU300_SIM_SLOT')
    if slot is not None:
        if slot not in ('0', '1'): raise ValueError('Invalid SIM slot')
        import time
        row=json.loads(Path('/run/t551m-sims.json').read_text())['sims'][int(slot)]
        if time.monotonic()-row['updated'] > 15 or row.get('error'): raise ValueError('Stale SIM status')
        print(json.dumps(dict(stat=row.get('reg'), tac=None, cid=None, act=row.get('act')),separators=(',',':')))
        raise SystemExit(0)
    result = subprocess.run(['mmcli', '-J', '-m', 'any', '--timeout=3'],
                            capture_output=True, text=True, timeout=4, check=True)
    modem = json.loads(result.stdout)['modem']
    state = {'idle': 0, 'home': 1, 'searching': 2, 'denied': 3, 'unknown': 4,
             'roaming': 5, 'emergency-only': 8}.get(modem['3gpp']['registration-state'])
    technologies = modem['generic']['access-technologies']
    act = 11 if '5gnr' in technologies else 7 if 'lte' in technologies else None
    print(json.dumps(dict(stat=state, tac=None, cid=None, act=act), separators=(',', ':')))
except (ValueError, KeyError, IndexError, TypeError, OSError, subprocess.SubprocessError):
    print('null')
