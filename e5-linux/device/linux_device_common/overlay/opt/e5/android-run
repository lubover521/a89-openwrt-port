#!/bin/sh
# Run an Android vendor daemon inside the chroot prepared by vendor-start.sh
# (e5-vendor.service).  Port of mu300-linux's android-run: the binary is exec'd
# directly so its task name (comm) matches what the vendor drivers expect, and
# the chroot's mounts are waited for instead of assuming the vendor service has
# finished.
set -e
A=/opt/e5/android
for n in $(seq 1 60); do mountpoint -q "$A/dev" && break; sleep 1; done
# a preloaded library from the host cannot be loaded by bionic's linker
unset LD_PRELOAD
elf_class=$(od -An -tu1 -j4 -N1 "$A/vendor/bin/$1" | tr -d ' \n')
case "$elf_class" in
  1) android_lib=lib ;;
  2) android_lib=lib64 ;;
  *) echo "invalid Android daemon ELF class: $1" >&2; exit 4 ;;
esac
export LD_LIBRARY_PATH=/apex/com.android.runtime/$android_lib/bionic:/system/$android_lib:/vendor/$android_lib
exec chroot "$A" /vendor/bin/"$1"
