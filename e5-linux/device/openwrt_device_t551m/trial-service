#!/bin/sh /etc/rc.common
# Return the bring-up image to Android if USB management never becomes usable.
START=15
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c '
        n=0
        while [ "$n" -lt 60 ]; do
            [ -e /tmp/t551m-keep ] && exit 0
            sleep 5
            n=$((n + 1))
        done
        logger -t t551m-trial "Unconfirmed trial: returning to Android"
        reboot'
    procd_close_instance
}
