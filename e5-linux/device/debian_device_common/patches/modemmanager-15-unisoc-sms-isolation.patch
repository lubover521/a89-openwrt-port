+        g_task_set_source_tag (task, e5_command_finish);
+        g_task_set_task_data (task, g_new0 (ScopedSmsCommand, 1), (GDestroyNotify) scoped_sms_free);
+        mm_base_modem_at_command (MM_BASE_MODEM (self), arg, timeout, FALSE,
+                                  (GAsyncReadyCallback) scoped_sms_ready, task);
         return;
     }
