Description: Match stock Unisoc indexed hangup and retain live calls on AT failure
Author: e5-linux
Forwarded: no

--- a/src/mm-base-call.c
+++ b/src/mm-base-call.c
@@ -688,12 +688,14 @@
         g_object_set_data (G_OBJECT (ctx->modem), "e5-voice-hangup-pending", NULL);
     }
 
-    /* we set it as terminated even if we got an error reported */
-    mm_base_call_change_state (self, MM_CALL_STATE_TERMINATED, MM_CALL_STATE_REASON_TERMINATED);
-
-    if (!MM_BASE_CALL_GET_CLASS (self)->hangup_finish (self, res, &error))
+    /* we set it as terminated on errors only for the original generic path.
+     * Unisoc CLCC remains authoritative after a rejected/timed-out command. */
+    if (!MM_BASE_CALL_GET_CLASS (self)->hangup_finish (self, res, &error)) {
+        if (!g_object_get_data (G_OBJECT (ctx->modem), "e5-dual-sim-voice"))
+            mm_base_call_change_state (self, MM_CALL_STATE_TERMINATED, MM_CALL_STATE_REASON_TERMINATED);
         mm_dbus_method_invocation_take_error (ctx->invocation, error);
-    else {
+    } else {
+        mm_base_call_change_state (self, MM_CALL_STATE_TERMINATED, MM_CALL_STATE_REASON_TERMINATED);
         /* note: timeouts are already removed when setting state as TERMINATED */
         mm_gdbus_call_complete_hangup (MM_GDBUS_CALL (ctx->self), ctx->invocation);
     }
@@ -1313,6 +1315,13 @@
     if (error) {
         mm_obj_warn (self, "couldn't hangup single call with call id '%u': %s",
                      self->priv->index, error->message);
+        /* A failed indexed Unisoc hangup must remain retryable. A global
+         * fallback may end another call on the same card instead. */
+        if (g_object_get_data (G_OBJECT (self->priv->modem), "e5-dual-sim-voice")) {
+            g_task_return_error (task, error);
+            g_object_unref (task);
+            return;
+        }
         g_error_free (error);
         chup_fallback (task);
         return;
@@ -1335,7 +1344,10 @@
     if (self->priv->index) {
         gchar *cmd;
 
-        cmd = g_strdup_printf ("+CHLD=1%u", self->priv->index);
+        /* Unisoc's stock requestHangup uses CHLD=7<index>, not 1<index>.
+         * Keep the existing card-scoped owner and leave other modems alone. */
+        cmd = g_strdup_printf (g_object_get_data (G_OBJECT (self->priv->modem), "e5-dual-sim-voice") ?
+                               "+CHLD=7%u" : "+CHLD=1%u", self->priv->index);
         call_at_command (self, cmd, 2,
                                   (GAsyncReadyCallback)chld_hangup_ready,
                                   task);
