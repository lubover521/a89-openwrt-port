--- a/src/plugins/unisoc/mm-broadband-modem-unisoc.c	2026-10-12 19:54:34.932193144 +0800
+++ b/src/plugins/unisoc/mm-broadband-modem-unisoc.c	2026-10-13 15:26:12.780848258 +0800
@@ -113,6 +113,43 @@
                         G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_MESSAGING, iface_modem_messaging_init)
                         G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM_VOICE, iface_modem_voice_init))
 
+
+#define UNISOC_BEARER_EVENT_FIFO "/run/modemmanager-unisoc-bearer.events"
+
+static void
+unisoc_bearer_event (const gchar *kind,
+                      const gchar *text)
+{
+    g_autofree gchar *line = NULL;
+    int               fd;
+
+    /* The netifd monitor owns this FIFO.  O_NONBLOCK means modem handling can
+     * never wait for a reader during boot, teardown or an interface restart. */
+    fd = open (UNISOC_BEARER_EVENT_FIFO, O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0)
+        return;
+    line = g_strdup_printf ("%s %s\n", kind, text ? text : "");
+    (void) write (fd, line, strlen (line));
+    close (fd);
+}
+
+static void
+unisoc_cgev_received (MMBroadbandModem *self,
+                       const gchar      *indication)
+{
+    unisoc_bearer_event ("cgev", indication);
+}
+
+static void
+sppcodata_received (MMPortSerialAt *port,
+                      GMatchInfo     *match_info,
+                      gpointer        user_data)
+{
+    g_autofree gchar *indication = NULL;
+
+    indication = g_match_info_fetch (match_info, 1);
+    unisoc_bearer_event ("sppcodata", indication);
+}
