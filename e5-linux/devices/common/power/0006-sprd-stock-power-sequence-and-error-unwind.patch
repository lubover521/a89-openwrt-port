-	}
-
-	dev_err(pd->dev, "camera domain did not power up (state 0x%x)\n",
-		val & pd->power_state.mask);
-	regmap_update_bits(pd->force_shutdown.map, pd->force_shutdown.reg,
-			   pd->force_shutdown.mask, pd->force_shutdown.mask);
-	clk_disable_unprepare(pd->mm_eb);
-
-	return -ETIMEDOUT;
+	int ret, cleanup;
+
+	if (!pd->clock_on) {
+		ret = clk_prepare_enable(pd->mm_eb);
+		if (ret)
