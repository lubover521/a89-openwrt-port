 {
 	struct camsys_pd *pd = container_of(gpd, struct camsys_pd, gpd);
-	unsigned int val;
-	int ret, i;
-
-	ret = clk_prepare_enable(pd->mm_eb);
-	if (ret)
-		return ret;
-
