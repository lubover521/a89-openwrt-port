-			   pd->force_shutdown.mask, 0);
-
-	for (i = 0; i < CAMSYS_POLL_MAX; i++) {
-		regmap_read(pd->power_state.map, pd->power_state.reg, &val);
-		if ((val & pd->power_state.mask) == CAMSYS_STATE_ON)
-			return 0;
