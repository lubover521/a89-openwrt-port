#!/bin/sh /etc/rc.common
START=81
STOP=09
USE_PROCD=1

start_service() {
    # MM owns nr1; its long network/SMS transactions never occupy these queues.
    # nr2: terminal/configuration; nr6/nr7: two bounded collector slots.
    for channel in 2 6 7; do
        procd_open_instance nr$channel
        procd_set_param command /usr/bin/python3 /opt/e5/t551m-atd --serve --channel "$channel"
        procd_set_param respawn 3600 5 5
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    done
}
