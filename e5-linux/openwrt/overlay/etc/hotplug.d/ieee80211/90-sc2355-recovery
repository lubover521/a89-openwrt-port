#!/bin/sh
# Firmware-reset recovery; no polling and no action on ordinary station events.
[ "$ACTION" = change ] && [ "$SC2355_RECOVERY" = 1 ] || exit 0
case "$DEVPATH" in */ieee80211/phy[0-9]*) ;; *) exit 0 ;; esac

. /lib/functions.sh

recover_radio() {
	local section="$1" path type disabled now last
	config_get type "$section" type
	config_get path "$section" path
	[ "$type" = mac80211 ] && [ -n "$path" ] || return 0
	case "$radio_device" in */"$path") ;; *) return 0 ;; esac
	config_get_bool disabled "$section" disabled 0
	[ "$disabled" = 0 ] || return 0
	read -r now _ < /proc/uptime
	now="${now%%.*}"
	last=0
	[ ! -f "/tmp/sc2355-recovery-$section.last" ] || read -r last < "/tmp/sc2355-recovery-$section.last"
	case "$last" in ''|*[!0-9]*) last=0 ;; esac
	if [ "$last" -gt 0 ] && [ "$((now - last))" -lt 60 ]; then
		logger -t sc2355-recovery "Repeated firmware reset on $section; automatic retry suppressed"
		return 0
	fi
	printf '%s\n' "$now" > "/tmp/sc2355-recovery-$section.last"
	logger -t sc2355-recovery "Firmware reset on $section; reopening wireless radio"
	wifi down "$section" || return 1
	# Allow the WCN reset notifier/SDIO removal to finish before powering up.
	sleep 1
	config_load wireless
	config_get_bool disabled "$section" disabled 0
	[ "$disabled" = 0 ] || return 0
	wifi up "$section"
}

(
	flock -n 9 || exit 0
	radio_device="$(readlink -f "/sys$DEVPATH/device")"
	[ -n "$radio_device" ] || exit 0
	config_load wireless
	config_foreach recover_radio wifi-device
) 9>/tmp/sc2355-recovery.lock
