#!/bin/sh
# Local boot intent only: no AT, misc writes, cache or timer.
boot_status() {
    local state=android temporary=true writable=false cmdline= dir helper runtime
    dir=${BOOT_STATE_DIR:-/etc/e5linux}
    helper=${BOOT_CONTROL_HELPER:-/opt/e5/e5-next-boot}
    if [ -e "$dir/default-boot" ]; then
        IFS= read -r state < "$dir/default-boot" || :
    fi
    case "$state" in
        linux) temporary=false ;;
        android) ;;
        *) state=unknown; temporary=null ;;
    esac
    runtime=${BOOT_RUNTIME_DIR:-/run/e5linux}
    if [ -x "$helper" ] && { [ -s "$runtime/misc-bc-slot-b-trial.bin" ] || [ -s "$dir/misc-bc-slot-b-trial.bin" ]; }; then
        writable=true
    fi
    IFS= read -r cmdline < "${BOOT_CMDLINE:-/proc/cmdline}" || :
    case " $cmdline " in *" e5.openwrt="*) writable=false ;; esac
    printf '{"default":"%s","temporary":%s,"can_set_default":%s}' "$state" "$temporary" "$writable"
}
[ "${BOOT_STATUS_LIBRARY:-0}" = 1 ] || boot_status
