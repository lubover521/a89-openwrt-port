+/* Never substitute guessed radio modes for an unavailable CP readback. */
+static gboolean
+power_parse_uint (const gchar **cursor,
+                  guint        *value)
+{
+    const gchar *p = *cursor;
+    gchar       *end;
+    guint64      number;
+
+    while (g_ascii_isspace (*p))
+        p++;
+    if (!g_ascii_isdigit (*p))
+        return FALSE;
+    errno = 0;
+    number = g_ascii_strtoull (p, &end, 10);
+    if (errno || number > G_MAXUINT)
+        return FALSE;
+    while (g_ascii_isspace (*end))
+        end++;
+    *cursor = end;
+    *value = (guint) number;
+    return TRUE;
+}
