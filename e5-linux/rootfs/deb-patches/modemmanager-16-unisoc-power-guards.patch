+/* Parent initialization_started() transferred its open-port context to
+ * this task. Release it on failure; a failed finish() cannot transfer it to
+ * the caller's initialization_stopped(). Do not run our success hook here. */
+static void
+init_power_failed (MMBaseModem *self,
+                   GTask       *task,
+                   GError      *error)
