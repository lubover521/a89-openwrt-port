Description: Schedule fixed Unisoc preferences without gating initialization or dialing
 A separate owner-aware worker confirms CEUS=1/CEMODE=2 with three retries.
 Initialization, radio enable and SIM switches use the same board-independent
 hook. Failures to launch or confirm the preferences cannot fail MM operations.
Author: e5-linux
Forwarded: no

--- a/src/plugins/unisoc/mm-broadband-modem-unisoc.c
+++ b/src/plugins/unisoc/mm-broadband-modem-unisoc.c
@@ -901,11 +901,40 @@
 
-static gboolean
-modem_power_finish (MMIfaceModem  *self,
-                    GAsyncResult  *res,
-                    GError       **error)
-{
-    return g_task_propagate_boolean (G_TASK (res), error);
-}
+/* Separate worker: no AT request is put on MM's synchronous enable path. */
+static void
+queue_data_priority (MMBaseModem *self)
+{
+    GError *error = NULL;
+    gchar slot[2] = { '0' + port_card (), '\0' };
+    gchar *argv[] = { (gchar *) "/opt/e5/e5-data-priority",
+                      (gchar *) "queue", slot, NULL };
+
+    if (!g_spawn_async (NULL, argv, NULL,
+                       G_SPAWN_STDOUT_TO_DEV_NULL | G_SPAWN_STDERR_TO_DEV_NULL,
+                       NULL, NULL, NULL, &error)) {
+        mm_obj_warn (self, "couldn't schedule data preferences (dial unaffected): %s", error->message);
+        g_clear_error (&error);
+    }
+}
+
+static gboolean
+modem_power_finish (MMIfaceModem  *self,
+                    GAsyncResult  *res,
+                    GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static gboolean
+modem_power_up_finish (MMIfaceModem  *self,
+                      GAsyncResult  *res,
+                      GError       **error)
+{
+    gboolean ready = modem_power_finish (self, res, error);
+
+    if (ready)
+        queue_data_priority (MM_BASE_MODEM (self));
+    return ready;
+}
 
 static void
 power_command_ready (MMBaseModem  *self,
@@ -976,2 +1005,17 @@
+static gboolean
+initialization_stopped (MMBroadbandModem *self,
+                        gpointer          ports,
+                        GError          **error)
+{
+    gboolean ready;
+
+    ready = MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_unisoc_parent_class)->initialization_stopped (self, ports, error);
+    /* Wait for initialization to END, not initialization_started_finish:
+     * the MM command endpoint is not ready during early SIM probing. */
+    if (ready)
+        queue_data_priority (MM_BASE_MODEM (self));
+    return ready;
+}
+
 static gpointer
 initialization_started_finish (MMBroadbandModem  *self,
@@ -1478,3 +1522,3 @@
     iface->modem_power_up = modem_power_up;
-    iface->modem_power_up_finish = modem_power_finish;
+    iface->modem_power_up_finish = modem_power_up_finish;
     iface->modem_power_down = modem_power_down;
@@ -1509,3 +1553,4 @@
     broadband_modem_class->initialization_started = initialization_started;
     broadband_modem_class->initialization_started_finish = initialization_started_finish;
+    broadband_modem_class->initialization_stopped = initialization_stopped;
 
